# Server / App Environment
NODE_ENV=development

# Database Configuration
DB_PATH=./jobs.db

# Matching System Configuration
MIN_MATCH_SCORE=70

# Schedule Configuration (node-cron expressions)
JOB_CHECK_CRON=*/5 * * * *
DAILY_SUMMARY_CRON=0 18 * * *

# Telegram Configuration (Placeholder for future setup)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
